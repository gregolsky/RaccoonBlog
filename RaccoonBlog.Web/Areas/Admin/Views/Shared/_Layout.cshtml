<!DOCTYPE html>
<html>
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1 user-scalable=no" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<meta name="format-detection" content="telephone=no" />
	<meta name="theme-color" content="#FFF" />
	<meta name="msapplication-tap-highlight" content="no" />

	<title>RaccoonBlog :: @ViewBag.Title</title>

	<link href='//fonts.googleapis.com/css?family=Lato:300,400,700&subset=latin,latin-ext' rel='stylesheet' type='text/css' />
	@* ASP.NET Core: Direct CSS references *@
	<link rel="stylesheet" href="~/Areas/Admin/Content/css/admin.styles.css" />
	@Html.RenderAdminTheme()
	@await RenderSectionAsync("Style", required: false)
</head>
<body>
	<section class="main-nav">
		<div class="container">
			<div class="navbar-header">
				<button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
					<span class="sr-only">Toggle navigation</span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
				</button>
				<a class="navbar-brand" asp-route="homepage">Raccoon Blog</a>
			</div>
			<div id="navbar" class="navbar-collapse collapse">
				<ul class="nav navbar-nav">
					@await Html.PartialAsync("RenderMenu", RaccoonBlog.Web.Areas.Admin.Helpers.MenuUtil.GetTopMenu(Url, Context.Request))
				</ul>
				<ul class="nav navbar-nav navbar-right">
					<li><a asp-area="Admin" asp-controller="Login" asp-action="Logout"><span class="glyphicon glyphicon-user" aria-hidden="true"></span> Logout</a></li>
				</ul>
			</div>
		</div>
	</section>
	<div class="container">
		<section class="content">
			@RenderBody()
		</section>
	</div>
	<footer>
		<div class="container">
			<span class="small">Copyright © Raccoon Blog 2011 - @DateTime.Now.Year</span>
		</div>
	</footer>

	@* ASP.NET Core: Direct script references *@
	<script src="~/Content/js/jquery.min.js"></script>
	<script src="~/Content/js/jquery-migrate.min.js"></script>
	<script src="~/Content/js/bootstrap.min.js"></script>
	<script src="~/Areas/Admin/Content/js/tinymce/tinymce.min.js"></script>
	<script src="~/Content/js/admin/main.js"></script>
	@await RenderSectionAsync("Script", required: false)

</body>
</html>